# /opt/artifacts/.env on the box (mode 600). Never committed.
# migrate.sh fills the secrets from the Fly machine; the rest is fixed.

PUBLIC_SHARE_ORIGIN=https://byagent.dev
PUBLIC_API_ORIGIN=https://app.byagent.dev
GUEST_PUBLISH=on
# Every page on its own host, https://<slug>.byagent.dev/. Set to byagent.dev
# only once the *.byagent.dev tunnel hostname answers (RUNBOOK: Page hosts).
# Empty = /a/<id>/.
CONTENT_DOMAIN=

# Operator key for the admin tenant. Same value as on Fly.
ADMIN_TOKEN=
# Signs keys, sessions and share-code unlocks. Must match Fly's, or every
# existing key and session stops working after the move.
KEY_SIGNING_SECRET=

# Web sign-in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=

GOOGLE_ANALYTICS_ID=

# Seals account variables (API keys for pages' proxy routes) at rest:
# openssl rand -base64 32. Unset turns variables and proxy routes off. Keep a
# copy in the password manager: without it every stored value is lost.
VARIABLES_KEY=

# Cloudflare Tunnel (Zero Trust > Networks > Tunnels > byagent > token).
TUNNEL_TOKEN=

# READ_ONLY=on pauses publishing and comments during a server move.
READ_ONLY=

# Metrics to Grafana Cloud (otel-collector.yaml). Leave all four empty to run
# without telemetry. The access policy token needs metrics:write only.
COMPOSE_PROFILES=
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_AUTH=
# Set to http://otel-collector:4318 to have the app push its own metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=
