  "type": "module",
  "bin": {
    "byagent": "bin/byagent.js"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "byagent",
    "claude-code",
    "codex",
    "cursor",
    "ai-agent",
    "agent-skills",
    "coding-agent",
    "publish",
    "share",
    "markdown",
    "html",
    "comments",
    "feedback",
    "artifacts",
    "static-site",
    "cli"
  ],
  "homepage": "https://byagent.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anup-a/artifacts.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/anup-a/artifacts/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/unit.test.mjs test/hooks.test.mjs test/markdown.test.mjs test/e2e.test.mjs"
  },
  "dependencies": {
    "marked": "^18.0.13"
  }
}
